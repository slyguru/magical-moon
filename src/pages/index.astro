---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
// IconRss removed
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
// featuredPosts removed
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="!border-accent border-b pt-8 pb-6">
  <h1 class="my-4 inline-block text-2xl font-bold font-mono sm:my-8 sm:text-xl">
    $ less /etc/motd
  </h1>
      <p class="my-2 leading-relaxed">
          Cyberspace is a perpetual battleground where modern enterprises stand exposed to an evolving tide of sophisticated threats. At the critical intersection of traditional defense and modern infrastructure lies a vital frontier—one that demands constant vigilance, relentless architecture hardening, and absolute mastery over identity and access.
          <br><br>
          This domain is not just a collection of technical logs; it is a forward operating base. Here, we embrace a <strong>No Zero Day</strong> mindset, recognizing that true defense requires digital warriors who refuse to stand still. You are about to read a dispatch straight from the front lines of cloud sec, adversary emulation, and cyber defense, packed with high-value instructional tidbits crafted by a practitioner in the trenches.
          <br><br>
          Read the dispatches, study the configurations, and prepare to execute.
      </p>

      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

{
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-8 pb-6">
          <h2 class="my-4 inline-block text-2xl font-bold font-mono sm:my-8 sm:text-xl">
            $ more juicy_posts.txt
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
