---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

// 1. Import the Postcard component here
import PostcardReviews from "@/components/PostcardReviews.astro";

const fame = await getEntry("pages", "wall-of-fame");

if (!fame) {
  throw new Error(
    "Missing content entry: `wall-of-fame.md` in `src/content/pages/`"
  );
}

const { Content } = await render(fame);
---

<Layout
  title={`${fame.data.title} | ${config.site.title}`}
  description={fame.data.description}
>
  <Header />
  <Breadcrumb />

  <Main pageTitle={fame.data.title} class="app-prose">
    {/* Renders your markdown text (e.g., intro paragraphs) */}
    <Content />

    {/* 2. Postcard Component */}
    <div class="mt-10 not-prose">
      <PostcardReviews />
    </div>

    {/* 3. Additional text section added below the postcard */}
    <div class="mt-4 prose max-w-none app-prose">
      <h3 class="font-semibold text-skin-base">Looking to Collaborate?</h3>
      <p class="text-skin-muted">
        I welcome connections across the cybersecurity spectrum. Whether you are an enthusiast looking for guidance, an organization exploring security auditing, cyber hygiene training, or a team with an exciting cybersecurity opportunity to share, I would love to hear from you. Feel free to connect via the <a href="/contact" class="!text-[color:rgba(var(--color-accent),1)] underline decoration-dashed underline-offset-4 hover:opacity-80 transition-opacity">contact form</a>.
      </p>
    </div>
  </Main>

  <Footer />
</Layout>
