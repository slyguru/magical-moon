---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const azureGuides = await getEntry("pages", "azure-how-tos");

if (!azureGuides) {
  throw new Error(
    "Missing content entry: `azure-how-tos.md` in `src/content/pages/`"
  );
}

const { Content } = await render(azureGuides);
---

<Layout
  title={`${azureGuides.data.title} | ${config.site.title}`}
  description={azureGuides.data.description}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={azureGuides.data.title} class="app-prose">
    <Content />
  </Main>
  <Footer />
</Layout>