---
// src/components/ContactForm.astro
// Replace 'YOUR_ACCESS_KEY_HERE' with your actual Web3Forms access key
const ACCESS_KEY = "3fb1bfa3-5330-4ed1-b79f-a998fbd41ab1";
---

<style>
  /* Classic Airmail Border Configuration */
  .airmail-border {
    --stripe-red: #c93a40;
    --stripe-blue: #2d4571;
    --paper-color: #fcfbf8; /* Vintage off-white envelope color */

    background: repeating-linear-gradient(
      -45deg,
      var(--stripe-red) 0px,
      var(--stripe-red) 16px,
      var(--paper-color) 16px,
      var(--paper-color) 32px,
      var(--stripe-blue) 32px,
      var(--stripe-blue) 48px,
      var(--paper-color) 48px,
      var(--paper-color) 64px
    );
  }

  .airmail-inner {
    background-color: var(--paper-color);
  }

  /* Dark Mode Overrides for a seamless look against your polygon background */
  html[data-theme="dark"] .airmail-border {
    --stripe-red: #ff6b01;
    --stripe-blue: #006cac;
    --paper-color: #121214; /* Extremely dark solid color to block the polygons */
  }
</style>

<!-- Outer Envelope Layer: Uses padding to expose just the edge of the striped gradient -->
<div class="airmail-border mx-auto max-w-2xl rounded-xl p-2.5 shadow-xl sm:p-3">

  <!-- Inner Letter Layer: Solid paper color to completely block the stripes in the center -->
  <div class="airmail-inner rounded-lg p-6 sm:p-10">

    <div class="mb-8 text-center">
      <h2 class="text-2xl font-medium italic text-skin-base sm:text-3xl">
        Get in Touch
      </h2>
      <p class="mt-3 text-base text-skin-muted sm:mt-4">
        Have a question, want to collaborate, a quick check-in or talk cybersecurity? Drop me a message below.
      </p>
    </div>

    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      id="contact-form"
      class="flex flex-col gap-6"
    >
      <!-- Web3Forms Access Key -->
      <input type="hidden" name="access_key" value={ACCESS_KEY} />
      <input type="hidden" name="subject" value="New Portfolio Contact Message" />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <!-- Name Input -->
        <div class="group relative">
          <label for="name" class="mb-2 block text-sm font-medium text-skin-base">Full Name</label>
          <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-skin-muted transition-colors group-focus-within:text-skin-accent">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </div>
            <input
              type="text"
              name="name"
              id="name"
              required
              placeholder="John Doe"
              class="block w-full rounded-lg border-2 border-[color:rgba(var(--color-accent),1)] bg-[color:var(--paper-color)] py-3 pl-11 pr-4 text-skin-base placeholder:text-skin-muted focus:outline-none focus:ring-1 focus:ring-[color:rgba(var(--color-accent),1)]"
            />
          </div>
        </div>

        <!-- Email Input -->
        <div class="group relative">
          <label for="email" class="mb-2 block text-sm font-medium text-skin-base">Email Address</label>
          <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-skin-muted transition-colors group-focus-within:text-skin-accent">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <input
              type="email"
              name="email"
              id="email"
              required
              placeholder="you@domain.com"
              class="block w-full rounded-lg border-2 border-[color:rgba(var(--color-accent),1)] bg-[color:var(--paper-color)] py-3 pl-11 pr-4 text-skin-base placeholder:text-skin-muted focus:outline-none focus:ring-1 focus:ring-[color:rgba(var(--color-accent),1)]"
            />
          </div>
        </div>
      </div>

      <!-- Message Textarea -->
      <div class="group relative">
        <label for="message" class="mb-2 block text-sm font-medium text-skin-base">Your Message</label>
        <textarea
          name="message"
          id="message"
          required
          rows="5"
          placeholder="How can I help you?"
          class="block w-full rounded-lg border-2 border-[color:rgba(var(--color-accent),1)] bg-[color:var(--paper-color)] p-4 text-skin-base placeholder:text-skin-muted focus:outline-none focus:ring-1 focus:ring-[color:rgba(var(--color-accent),1)]"
        ></textarea>
      </div>

      <!-- Submit Button -->
      <button
        type="submit"
        id="submit-btn"
        class="group mt-2 inline-flex w-full items-center justify-center gap-2 rounded-lg border-2 border-[color:rgba(var(--color-accent),1)] bg-transparent px-8 py-3.5 text-base font-semibold text-skin-accent transition-all duration-300 hover:bg-skin-accent hover:text-skin-inverted focus:outline-none focus:ring-2 focus:ring-[color:rgba(var(--color-accent),1)] focus:ring-offset-2 active:scale-[0.98] sm:w-auto sm:self-end"
      >
        <span id="btn-text">Send Message</span>
        <svg id="btn-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        <svg id="btn-spinner" class="hidden h-5 w-5 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
      </button>

      <!-- Result Message -->
      <div id="result" class="hidden rounded-lg border-2 p-4 text-center text-sm font-medium transition-all"></div>
    </form>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    if (!form) return;
    if (form.getAttribute("data-initialized") === "true") return;
    form.setAttribute("data-initialized", "true");

    const result = document.getElementById("result") as HTMLDivElement;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
    const btnText = document.getElementById("btn-text") as HTMLSpanElement;
    const btnIcon = document.getElementById("btn-icon") as HTMLElement;
    const btnSpinner = document.getElementById("btn-spinner") as HTMLElement;

    form.addEventListener("submit", function (e) {
      e.preventDefault();

      const formData = new FormData(form);
      const object = Object.fromEntries(formData);
      const json = JSON.stringify(object);

      if (submitBtn && btnText && btnIcon && btnSpinner) {
        submitBtn.disabled = true;
        submitBtn.classList.add("opacity-70", "cursor-not-allowed");
        btnText.innerText = "Sending...";
        btnIcon.classList.add("hidden");
        btnSpinner.classList.remove("hidden");
      }

      if (result) {
        result.classList.add("hidden");
        result.className = "hidden rounded-lg border-2 border-[color:rgba(var(--color-accent),1)] bg-[color:var(--paper-color)] p-4 text-center text-sm font-medium transition-all";
      }

      fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: json,
      })
        .then(async (response) => {
          const jsonResponse = await response.json();
          if (result) {
            result.classList.remove("hidden");

            if (response.status == 200) {
              result.innerHTML = "✨ Message sent successfully! I'll get back to you soon.";
              result.classList.add("text-skin-base");
              form.reset();
            } else {
              result.innerHTML = jsonResponse.message;
              result.style.color = "red";
              result.style.borderColor = "red";
            }
          }
        })
        .catch((error) => {
          console.log(error);
          if (result) {
            result.classList.remove("hidden");
            result.innerHTML = "Something went wrong! Please try again later.";
            result.style.color = "red";
            result.style.borderColor = "red";
          }
        })
        .finally(() => {
          if (submitBtn && btnText && btnIcon && btnSpinner) {
            submitBtn.disabled = false;
            submitBtn.classList.remove("opacity-70", "cursor-not-allowed");
            btnText.innerText = "Send Message";
            btnIcon.classList.remove("hidden");
            btnSpinner.classList.add("hidden");
          }

          if(result && result.classList.contains("text-skin-base")) {
              setTimeout(() => {
                  result.classList.add("hidden");
              }, 5000);
          }
        });
    });
  });
</script>
