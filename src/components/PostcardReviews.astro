---
// src/components/PostcardReviews.astro

const initialReviews = [
  {
    name: "Didacus A.",
    designation: "Mentee",
    program: "Moringa",
    country: "Kenya",
    text: "The 'No Zero Day' mindset completely shifted how I approach my technical execution. The 120-minute SOC simulation gauntlets forced us to apply what we learned in a real-world, high-pressure environment."
  },
  {
    name: "Joygloria C.",
    designation: "Mentee",
    program: "Moringa",
    country: "Kenya",
    text: "Strict but incredibly effective. The evaluation rubrics for our Windows Server 2022 hardening projects pushed us to actually understand CIS benchmarks. You can't just skim the surface in this cohort."
  },
  {
    name: "Denis B.",
    designation: "Mentee",
    program: "Moringa",
    country: "Kenya",
    text: "What sets this mentorship apart is the depth. We didn't just look at surface-level vulnerabilities; we mapped out the critical architectural building blocks of APIs to understand exactly how the infrastructure functions."
  },
  {
    name: "Daniel O.",
    designation: "Mentee",
    program: "Moringa",
