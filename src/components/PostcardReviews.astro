  },
  {
    name: "Orifha Joan",
    designation: "Mentee",
    program: "CyberGirls",
    country: "Nigeria",
    text: "Live session with you has been amazing and insightful."
  }
];

// Extract Peace Ojo
const peaceReview = initialReviews.find(r => r.name === "Peace Ojo");

// Filter out Peace Ojo to shuffle the rest
const restOfReviews = initialReviews.filter(r => r.name !== "Peace Ojo");

// Shuffle the remaining reviews (Fisher-Yates Shuffle)
for (let i = restOfReviews.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [restOfReviews[i], restOfReviews[j]] = [restOfReviews[j], restOfReviews[i]];
}

// Recombine so Peace is first, followed by the randomized ones
const reviews = [peaceReview, ...restOfReviews];
---

<div class="review-board">
  <div class="slideshow-wrapper" id="postcard-slideshow">
    <!-- Previous Button -->
    <button class="nav-btn prev" aria-label="Previous Review">&#10094;</button>

    <div class="slideshow-container">
      {reviews.map((review, index) => (
        <div class={`mail-card ${index === 0 ? 'active' : ''}`}>
          <div class="mail-card-inner">
            <div class="review-section">
              <p class="note-text">"{review.text}"</p>
            </div>
            <div class="divider"></div>
            <div class="address-section">
              <div class="stamp">PASS</div>
              <div class="postmark">
                <span>NAIROBI<br>AUG 3<br>2026</span>
              </div>
              <div class="designation">{review.designation}</div>

              <!-- Populating the previously empty address line -->
              <div class="address-line">
                <div class="location-text" title={`${review.program}, ${review.country}`}>
                  {review.program}, {review.country}
                </div>
              </div>

              <div class="address-line">
                <div class="author-name" title={review.name}>{review.name}</div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Next Button -->
    <button class="nav-btn next" aria-label="Next Review">&#10095;</button>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Special+Elite&display=swap');

  /* The Container - Tightly fit to the postcard */
  .review-board {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 220px;
    width: 100%;

    background: transparent !important;
    box-shadow: none !important;
    overflow: visible;

    margin-top: -35px;
    margin-bottom: 0;
    padding: 10px 0;
  }

  /* Slideshow Wrapper for aligning controls and cards */
  .slideshow-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
  }

  .slideshow-container {
    position: relative;
    width: 300px;
    height: 165px;
  }

  /* The Mail Card Wrapper */
  .mail-card {
    width: 100%;
    height: 100%;

    /* Slideshow positioning */
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    visibility: hidden;
    transform: scale(0.95) rotate(-2deg);

    /* Airmail border pattern - scaled down */
    background: repeating-linear-gradient(
      -45deg,
      #c0392b 0, #c0392b 10px,
      #fdf6e3 10px, #fdf6e3 20px,
      #2980b9 20px, #2980b9 30px,
      #fdf6e3 30px, #fdf6e3 40px
    );
    padding: 6px;
    box-sizing: border-box;

    /* Tattered Edge Effect */
    clip-path: polygon(
      1% 2%, 4% 0%, 12% 2%, 22% 0%, 35% 1%, 45% 0%, 55% 2%, 67% 0%, 75% 1%, 86% 0%, 96% 2%, 99% 0%,
      100% 12%, 98% 23%, 100% 34%, 99% 45%, 100% 55%, 98% 66%, 100% 77%, 99% 88%, 100% 98%,
      95% 100%, 85% 98%, 76% 100%, 65% 99%, 56% 100%, 45% 98%, 34% 100%, 24% 99%, 13% 100%, 5% 98%, 0% 100%,
      2% 87%, 0% 76%, 1% 65%, 0% 54%, 2% 43%, 0% 32%, 1% 21%, 0% 10%
    );

    filter: drop-shadow(5px 8px 6px rgba(0, 0, 0, 0.7));
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: pointer;
  }

  /* Active Slide State */
  .mail-card.active {
    opacity: 1;
    visibility: visible;
    transform: scale(1) rotate(0deg);
    z-index: 10;
  }

  /* The Inner Postcard Canvas */
  .mail-card-inner {
    background-color: #fdf5e6;
    background-image: url('https://www.transparenttextures.com/patterns/cream-paper.png');
    height: 100%;
    width: 100%;
    display: flex;
    position: relative;
    overflow: hidden;
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.15);
  }

  .review-section {
    flex: 1; /* Takes up remaining space */
    padding: 10px;
    display: flex;
    align-items: center;
  }

  .note-text {
    font-family: 'Architects Daughter', cursive;
    font-size: 11px;
    line-height: 1.25;
    color: #1a1a24;
    margin: 0;
    text-align: left;
  }

  .divider {
    width: 1.5px;
    background: rgba(0, 0, 0, 0.15);
    margin: 10px 0;
  }

  .address-section {
    width: 135px; /* Rigid width to ensure address line boundaries */
    flex: none;
    padding: 15px 10px 15px 10px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* Faded blue stamp with Graduation Hat */
  .stamp {
    position: absolute;
    top: 15px;
    right: 15px;
    width: 30px;
    height: 40px;

    background-color: #5c85a6; /* Faded vintage blue */
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='rgba(253, 245, 230, 0.45)'%3E%3Cpath d='M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72l5 2.73 5-2.73v3.72z'/%3E%3C/svg%3E");
    background-size: 20px;
    background-position: center 4px;
    background-repeat: no-repeat;

    border: 2px dashed #fdf5e6;
    outline: 1px solid rgba(0, 0, 0, 0.2);
    box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.2);

    display: flex;
    justify-content: center;
    align-items: flex-end;
    padding-bottom: 4px;

    font-family: 'Special Elite', monospace;
    font-size: 9px;
    font-weight: 700;
    color: rgba(253, 245, 230, 0.95);
    letter-spacing: 0.5px;
  }

  /* Faded blue ink postmark */
  .postmark {
    position: absolute;
    top: 10px;
    right: 32px;
    width: 55px;
    height: 55px;
    border: 1.5px solid rgba(56, 92, 133, 0.5);
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: 'Special Elite', monospace;
    font-size: 8px;
    color: rgba(56, 92, 133, 0.6);
    transform: rotate(-18deg);
    pointer-events: none;
    z-index: 2;
  }

  .postmark span { line-height: 1.2; text-align: center; }

  .postmark::after {
    content: "≈≈≈≈≈";
    position: absolute;
    right: -25px;
    font-size: 14px;
    letter-spacing: -1.5px;
    color: rgba(56, 92, 133, 0.4);
    transform: translateY(-4px);
  }

  .designation {
    font-family: 'Special Elite', monospace;
    font-size: 9px;
    color: rgba(40, 40, 40, 0.75);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding-left: 8px;
    margin-top: 6px;
    margin-bottom: 1px;
    position: relative;
    z-index: 3;
  }

  .address-line {
    height: 18px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.15);
    width: 100%;
    position: relative; /* Acts as anchor for the absolute positioned text */
  }

  /* Text positioned absolutely to guarantee truncation bounds */
  .location-text {
    font-family: 'Special Elite', monospace;
    font-size: 9px;
    color: rgba(40, 40, 40, 0.85);

    position: absolute;
    bottom: -1px; /* Sits right on the underline */
    left: 8px;
    right: 0; /* Forces a hard cutoff exactly at the edge of the line */
    margin: 0;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .author-name {
    font-family: 'Special Elite', monospace;
    font-size: 10px;
    font-weight: normal;
    color: rgba(40, 40, 40, 0.85);

    position: absolute;
    bottom: -1px;
    left: 8px;
    right: 0;
    margin: 0;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Hover Effect: Magnifies slightly to read */
  .mail-card.active:hover {
    transform: scale(1.1) rotate(0deg);
    filter: drop-shadow(10px 15px 15px rgba(0, 0, 0, 0.9));
  }

  /* Slideshow Controls */
  .nav-btn {
    cursor: pointer;
    background: rgba(40, 30, 20, 0.7);
    color: #fdf5e6;
    border: 1px solid #5c85a6;
    border-radius: 5px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    transition: background 0.3s, transform 0.2s;
    z-index: 20;
  }

  .nav-btn:hover {
    background: #5c85a6;
    transform: scale(1.1);
  }
</style>

<script>
  function initPostcards() {
    const wrapper = document.getElementById('postcard-slideshow');
    if (!wrapper) return;

    let currentSlideIndex = 0;
    const slides = wrapper.querySelectorAll('.mail-card');
    const prevBtn = wrapper.querySelector('.nav-btn.prev');
    const nextBtn = wrapper.querySelector('.nav-btn.next');

    // Remove old event listeners by cloning the buttons to prevent duplicate fires on navigation
    const newPrevBtn = prevBtn?.cloneNode(true);
    const newNextBtn = nextBtn?.cloneNode(true);

    if (prevBtn && newPrevBtn) prevBtn.parentNode?.replaceChild(newPrevBtn, prevBtn);
    if (nextBtn && newNextBtn) nextBtn.parentNode?.replaceChild(newNextBtn, nextBtn);

    function showSlide(index: number) {
      slides.forEach(slide => {
        slide.classList.remove('active');
      });

      if (index >= slides.length) {
        currentSlideIndex = 0;
      } else if (index < 0) {
        currentSlideIndex = slides.length - 1;
      } else {
        currentSlideIndex = index;
      }

      slides[currentSlideIndex].classList.add('active');
    }

    if (newPrevBtn) newPrevBtn.addEventListener('click', () => showSlide(currentSlideIndex - 1));
    if (newNextBtn) newNextBtn.addEventListener('click', () => showSlide(currentSlideIndex + 1));
  }

  // Run on initial load and view transitions
  initPostcards();
  document.addEventListener('astro:page-load', initPostcards);
</script>
